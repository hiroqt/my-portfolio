# Optional: enable hosted Groq responses. Empty uses the local portfolio assistant.
GROQ_API_KEY=

# Optional: enable ElevenLabs speech. Empty uses the existing TTS fallbacks.
ELEVENLABS_API_KEY=

# Optional: choose an ElevenLabs voice. Empty keeps the default voice.
ELEVENLABS_VOICE_ID=

# Optional: Upstash Redis for blog view counts (added by the Vercel Marketplace
# integration; pull with `vercel env pull`). Empty hides the view count.
KV_REST_API_URL=
KV_REST_API_TOKEN=
