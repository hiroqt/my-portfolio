# Groq API Configuration
# Get your API key from: https://console.groq.com/keys
# Sign up at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# GitHub Configuration (REQUIRED for private repos and accurate commit data)
# To include private repositories and accurate contribution counts:
# 1. Go to: https://github.com/settings/tokens
# 2. Click "Generate new token (classic)"
# 3. Select these scopes:
#    - repo (Full control of private repositories)
#    - read:user (Read user profile data)
# 4. Generate and copy the token below
# NOTE: Use GITHUB_TOKEN (not NEXT_PUBLIC_) to keep it secure on the server
GITHUB_TOKEN=your_github_personal_access_token_here
